# Application
APP_NAME=Study Rescue
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
ENV=development
DEBUG=false

# Server
HOST=127.0.0.1
PORT=8000

# Database (SQLite file path relative to project root)
# For production on Render, use a PostgreSQL connection string:
# DATABASE_URL=postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=sqlite:///data/studyrescue.db

# ── Session / Cookie (production) ─────────────────────────────────────
SESSION_COOKIE_NAME=studyrescue_session
# Set this to your Render domain in production (e.g. .onrender.com)
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=1209600
CSRF_MAX_AGE_SECONDS=7200

# ── CORS (enable if frontend is on a different origin) ────────────────
CORS_ENABLED=false
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
FRONTEND_URL=

# ── LLM configuration ─────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your-api-key-here
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Demo password (optional)
DEMO_PASSWORD=